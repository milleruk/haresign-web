# Secrets — never commit a real environment file
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/

# Build output: regenerated by collectstatic
staticfiles/

# Uploaded media — content, not code. Backed up separately (see README).
media/

# Migration artefacts, never committed. legacy_articles.json is the whole article
# corpus; legacy_subscribers.json is a list of real people's email addresses.
# Both are working files that should be deleted once an import is verified.
legacy_articles*.json
legacy_newsletters*.json
legacy_subscribers*.json
_migration/

# Responsive QA output — screenshots are review artefacts, not site assets.
qa/screenshots/

.pytest_cache/
.ruff_cache/
.DS_Store
