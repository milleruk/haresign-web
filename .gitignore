# Secrets — never commit a real environment file
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/

# Build output: regenerated by collectstatic
staticfiles/

# Uploaded media — content, not code. Backed up separately (see README).
media/

# Legacy export files are a migration artefact, never committed: they are a full
# copy of the monolith's article content.
legacy_articles*.json

.pytest_cache/
.ruff_cache/
.DS_Store
