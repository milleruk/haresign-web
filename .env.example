# ---------------------------------------------------------------------------
# haresign-web — copy to .env and fill in. Never commit the result.
# ---------------------------------------------------------------------------

# Required when DEBUG=False; the app refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=False
# 127.0.0.1 is needed by the container health check, which calls the app
# directly rather than through the proxy; without it Django answers 400.
ALLOWED_HOSTS=beta.haresign.net,127.0.0.1
LOG_LEVEL=INFO

# --- Site identity ---------------------------------------------------------
# Canonical origin. Becomes https://haresign.net when this replaces production.
SITE_BASE_URL=https://beta.haresign.net
SITE_NAME=Haresign

# Search indexing is OFF unless this is true. Leave false on beta — the point of
# the flag is that getting indexed is easy to do and slow to undo.
SITE_INDEXABLE=false

# Badge in the header marking this as a preview. Empty string removes it.
SITE_ENVIRONMENT_LABEL=Beta

# --- Haresign service registry ---------------------------------------------
# Subdomains will move during the migration, so these are configuration.
# Note the deliberate slug/host split: the variable names are the *product*
# names, the values the hosts already deployed. Renaming a live subdomain is a
# separate, riskier job than renaming a product.
HARESIGN_URL_CONSULTING=https://consulting.haresign.net
HARESIGN_URL_INTELLIGENCE=https://app.haresign.net
HARESIGN_URL_COMMUNITY=https://community.haresign.net
HARESIGN_URL_WORKSPACE=https://clients.haresign.net
HARESIGN_URL_ACCOUNT=https://auth.haresign.net
HARESIGN_URL_API=https://api.haresign.net

# Comma-separated slugs of services that actually resolve today. Anything not
# listed renders as "Coming soon" instead of a link. Add a slug the moment its
# DNS is live — no code change needed.
HARESIGN_LIVE_SERVICES=intelligence

# --- Legal / company details -----------------------------------------------
# Supplied by the business, not invented here. Unset values are omitted from the
# footer rather than shown as placeholders.
LEGAL_COMPANY_NAME=Haresign Consulting Services
LEGAL_COMPANY_NUMBER=
LEGAL_REGISTERED_ADDRESS=
LEGAL_ICO_REGISTRATION=
LEGAL_CONTACT_EMAIL=contact@haresign.net

# --- Server ----------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30

# TLS is terminated at Traefik. Leave the redirect on unless running without a
# proxy, where it would cause a loop.
SECURE_SSL_REDIRECT=true
